{
    "name": "specialistaweb/textimage_size",
    "type": "typo3-cms-extension",
    "description": "Changes the split between image and text (default 50% / 50%) of the bootstrap_package content elements Text & Media, Text & Images and Images: the image can take 1 to 11 twelfths of the width.",
    "keywords": [
        "TYPO3",
        "extension",
        "content",
        "text",
        "textpic",
        "textmedia",
        "media",
        "image",
        "size",
        "bootstrap_package"
    ],
    "homepage": "https://typo3.specialistaweb.it/development/textimage-size",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alessandro Tuveri",
            "role": "Developer"
        },
        {
            "name": "Giulia Tuveri",
            "email": "gt@specialistaweb.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "bk2k/bootstrap-package": "^13.0 || ^14.0 || ^15.0 || ^16.0",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-frontend": "^12.4 || ^13.4 || ^14.3"
    },
    "replace": {
        "typo3-ter/textimage-size": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "textimage_size"
        }
    }
}
