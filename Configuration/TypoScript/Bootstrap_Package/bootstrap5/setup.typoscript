# Text Media/Image size
# Requires bootstrap_package (content elements image, textpic, textmedia).

# The templates of this extension are used only for content elements with one of its layouts
# (tt_content.layout 6761-6771, and the old 6661-6671). Every other content element keeps the
# templates of the installed bootstrap_package version (and of the site package).
tt_content.image.templateRootPaths {
  6760 = EXT:textimage_size/Resources/Private/Templates/ContentElements/
  6760.stdWrap.if {
    value = 6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671
    isInList.field = layout
  }
}
tt_content.textpic.templateRootPaths {
  6760 = EXT:textimage_size/Resources/Private/Templates/ContentElements/
  6760.stdWrap.if {
    value = 6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671
    isInList.field = layout
  }
}
tt_content.textmedia.templateRootPaths {
  6760 = EXT:textimage_size/Resources/Private/Templates/ContentElements/
  6760.stdWrap.if {
    value = 6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671
    isInList.field = layout
  }
}

# Responsive image sizes for the selected width (n = 1...11 twelfths of the width).
#   side.n: image next to the text (left/right/centered); full.n: image above/below the text or alone.
# Small screens (below 768 px) show the image at full width, as bootstrap_package does.
lib.contentElement.settings.textimagesize {
  side {
    1 {
      multiplier {
        default = 0.0833
        xlarge = 0.0833
        large = 0.0833
        medium = 0.0833
      }
      gutters {
        default = 40
        xlarge = 40
        large = 40
        medium = 40
      }
    }
